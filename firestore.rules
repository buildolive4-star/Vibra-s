rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidStringList(list, maxLen) {
      return list is list &&
        list.size() <= maxLen &&
        (list.size() == 0 || (list[0] is string && list[0].size() <= 60));
    }

    function isValidUserProfile(data, userId) {
      return data.userId is string && data.userId == userId &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 40 &&
        data.avatarKey is string && data.avatarKey.size() >= 1 && data.avatarKey.size() <= 40 &&
        (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 20)) &&
        (!('countryCode' in data) || (data.countryCode is string && data.countryCode.size() <= 8)) &&
        data.virtualPoints is int && data.virtualPoints >= 0 && data.virtualPoints <= 10000000 &&
        data.totalPredictions is int && data.totalPredictions >= 0 && data.totalPredictions <= 1000000 &&
        data.correctPredictions is int && data.correctPredictions >= 0 && data.correctPredictions <= data.totalPredictions &&
        data.streakDays is int && data.streakDays >= 1 && data.streakDays <= 3650 &&
        isValidStringList(data.favoriteSports, 7) &&
        isValidStringList(data.favoriteTeams, 20) &&
        isValidStringList(data.badges, 12) &&
        data.language is string && data.language.size() >= 2 && data.language.size() <= 20 &&
        data.darkMode is bool &&
        data.notificationsEnabled is bool &&
        data.privacyPublicLeaderboard is bool &&
        data.termsAccepted is bool;
    }

    function isValidUserPrediction(data, userId) {
      return data.userId is string && data.userId == userId &&
        data.matchId is string && data.matchId.size() >= 1 && data.matchId.size() <= 64 &&
        data.matchTitle is string && data.matchTitle.size() >= 2 && data.matchTitle.size() <= 100 &&
        data.sport is string && data.sport.size() >= 2 && data.sport.size() <= 30 &&
        data.tournament is string && data.tournament.size() >= 2 && data.tournament.size() <= 60 &&
        data.marketType is string && data.marketType.size() >= 2 && data.marketType.size() <= 40 &&
        data.selectedPick is string && data.selectedPick.size() >= 1 && data.selectedPick.size() <= 60 &&
        data.stakePoints is int && data.stakePoints >= 10 && data.stakePoints <= 50000 &&
        data.multiplierX100 is int && data.multiplierX100 >= 110 && data.multiplierX100 <= 1500 &&
        data.potentialRewardPoints is int && data.potentialRewardPoints >= 11 && data.potentialRewardPoints <= 750000 &&
        data.status is string && data.status in ['ACTIVE', 'WON', 'LOST'] &&
        (!('resultSummary' in data) || (data.resultSummary is string && data.resultSummary.size() <= 140));
    }

    function isValidRewardClaim(data, userId) {
      return data.userId is string && data.userId == userId &&
        data.rewardType is string && data.rewardType in ['DAILY_LOGIN', 'WEEKLY_CHALLENGE', 'SPORTS_QUIZ', 'BADGE_BONUS'] &&
        data.rewardKey is string && data.rewardKey.size() >= 2 && data.rewardKey.size() <= 64 &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 80 &&
        data.pointsAwarded is int && data.pointsAwarded >= 10 && data.pointsAwarded <= 5000;
    }

    function isValidUserNotification(data, userId) {
      return data.userId is string && data.userId == userId &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 80 &&
        data.body is string && data.body.size() >= 2 && data.body.size() <= 220 &&
        data.category is string && data.category in ['MATCH_LIVE', 'TEAM_ALERT', 'RESULT', 'CHALLENGE', 'ACHIEVEMENT'] &&
        (!('matchId' in data) || (data.matchId is string && data.matchId.size() <= 64)) &&
        data.unread is bool;
    }

    function isValidLeaderboardEntry(data, userId) {
      return data.userId is string && data.userId == userId &&
        data.displayName is string && data.displayName.size() >= 2 && data.displayName.size() <= 40 &&
        data.avatarKey is string && data.avatarKey.size() >= 1 && data.avatarKey.size() <= 40 &&
        data.virtualPoints is int && data.virtualPoints >= 0 && data.virtualPoints <= 10000000 &&
        data.totalPredictions is int && data.totalPredictions >= 0 && data.totalPredictions <= 1000000 &&
        data.correctPredictions is int && data.correctPredictions >= 0 && data.correctPredictions <= data.totalPredictions &&
        data.accuracyPct is int && data.accuracyPct >= 0 && data.accuracyPct <= 100 &&
        isValidStringList(data.badges, 12) &&
        data.periodBucket is string && data.periodBucket in ['ALL', 'DAILY', 'WEEKLY', 'MONTHLY'] &&
        data.publicVisible is bool;
    }

    // 1. Private User Profile & Settings (PII protected: owner only)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().keys().hasAll([
          'userId', 'displayName', 'avatarKey', 'virtualPoints',
          'totalPredictions', 'correctPredictions', 'streakDays',
          'favoriteSports', 'favoriteTeams', 'badges', 'language',
          'darkMode', 'notificationsEnabled', 'privacyPublicLeaderboard',
          'termsAccepted', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'userId', 'displayName', 'avatarKey', 'phoneNumber', 'countryCode',
          'virtualPoints', 'totalPredictions', 'correctPredictions', 'streakDays',
          'favoriteSports', 'favoriteTeams', 'badges', 'language',
          'darkMode', 'notificationsEnabled', 'privacyPublicLeaderboard',
          'termsAccepted', 'createdAt', 'updatedAt'
        ]) &&
        isValidTimestamp(incoming().createdAt) &&
        isValidTimestamp(incoming().updatedAt);

      allow update: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        isValidTimestamp(incoming().updatedAt) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'avatarKey', 'phoneNumber', 'countryCode',
          'virtualPoints', 'totalPredictions', 'correctPredictions', 'streakDays',
          'favoriteSports', 'favoriteTeams', 'badges', 'language',
          'darkMode', 'notificationsEnabled', 'privacyPublicLeaderboard',
          'termsAccepted', 'updatedAt'
        ]);

      allow delete: if isValidId(userId) && isOwner(userId);

      // 2. User Virtual-Points Predictions
      match /predictions/{predictionId} {
        allow get: if isValidId(userId) && isValidId(predictionId) && isOwner(userId);
        allow list: if isOwner(userId);

        allow create: if isValidId(userId) &&
          isValidId(predictionId) &&
          isOwner(userId) &&
          isValidUserPrediction(incoming(), userId) &&
          incoming().status == 'ACTIVE' &&
          incoming().keys().hasAll([
            'userId', 'matchId', 'matchTitle', 'sport', 'tournament',
            'marketType', 'selectedPick', 'stakePoints', 'multiplierX100',
            'potentialRewardPoints', 'status', 'createdAt', 'updatedAt'
          ]) &&
          incoming().keys().hasOnly([
            'userId', 'matchId', 'matchTitle', 'sport', 'tournament',
            'marketType', 'selectedPick', 'stakePoints', 'multiplierX100',
            'potentialRewardPoints', 'status', 'resultSummary', 'createdAt', 'updatedAt'
          ]) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidTimestamp(incoming().updatedAt);

        allow update: if isValidId(userId) &&
          isValidId(predictionId) &&
          isOwner(userId) &&
          isValidUserPrediction(incoming(), userId) &&
          existing().status == 'ACTIVE' &&
          incoming().status in ['WON', 'LOST'] &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          isValidTimestamp(incoming().updatedAt) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'resultSummary', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidId(predictionId) && isOwner(userId);
      }

      // 3. User Reward Claims (Daily Login, Weekly Challenges, Quizzes)
      match /rewards_claims/{claimId} {
        allow get: if isValidId(userId) && isValidId(claimId) && isOwner(userId);
        allow list: if isOwner(userId);

        allow create: if isValidId(userId) &&
          isValidId(claimId) &&
          isOwner(userId) &&
          isValidRewardClaim(incoming(), userId) &&
          incoming().keys().hasAll(['userId', 'rewardType', 'rewardKey', 'title', 'pointsAwarded', 'createdAt']) &&
          incoming().keys().hasOnly(['userId', 'rewardType', 'rewardKey', 'title', 'pointsAwarded', 'createdAt']) &&
          isValidTimestamp(incoming().createdAt);

        allow update: if false;
        allow delete: if isValidId(userId) && isValidId(claimId) && isOwner(userId);
      }

      // 4. User Notifications
      match /notifications/{notificationId} {
        allow get: if isValidId(userId) && isValidId(notificationId) && isOwner(userId);
        allow list: if isOwner(userId);

        allow create: if isValidId(userId) &&
          isValidId(notificationId) &&
          isOwner(userId) &&
          isValidUserNotification(incoming(), userId) &&
          incoming().keys().hasAll(['userId', 'title', 'body', 'category', 'unread', 'createdAt', 'updatedAt']) &&
          incoming().keys().hasOnly(['userId', 'title', 'body', 'category', 'matchId', 'unread', 'createdAt', 'updatedAt']) &&
          isValidTimestamp(incoming().createdAt) &&
          isValidTimestamp(incoming().updatedAt);

        allow update: if isValidId(userId) &&
          isValidId(notificationId) &&
          isOwner(userId) &&
          isValidUserNotification(incoming(), userId) &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt &&
          isValidTimestamp(incoming().updatedAt) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['unread', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidId(notificationId) && isOwner(userId);
      }
    }

    // 5. Public PII-Free Leaderboard Entries (must query whereEqualTo("publicVisible", true))
    match /leaderboard_entries/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (existing().publicVisible == true || isOwner(userId));
      allow list: if isSignedIn() && existing().publicVisible == true;

      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidLeaderboardEntry(incoming(), userId) &&
        incoming().keys().hasAll([
          'userId', 'displayName', 'avatarKey', 'virtualPoints',
          'totalPredictions', 'correctPredictions', 'accuracyPct',
          'badges', 'periodBucket', 'publicVisible', 'createdAt', 'updatedAt'
        ]) &&
        incoming().keys().hasOnly([
          'userId', 'displayName', 'avatarKey', 'virtualPoints',
          'totalPredictions', 'correctPredictions', 'accuracyPct',
          'badges', 'periodBucket', 'publicVisible', 'createdAt', 'updatedAt'
        ]) &&
        isValidTimestamp(incoming().createdAt) &&
        isValidTimestamp(incoming().updatedAt);

      allow update: if isValidId(userId) &&
        isOwner(userId) &&
        isValidLeaderboardEntry(incoming(), userId) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        isValidTimestamp(incoming().updatedAt) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'avatarKey', 'virtualPoints',
          'totalPredictions', 'correctPredictions', 'accuracyPct',
          'badges', 'periodBucket', 'publicVisible', 'updatedAt'
        ]);

      allow delete: if isValidId(userId) && isOwner(userId);
    }
  }
}
