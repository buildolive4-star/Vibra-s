{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "BetZone X user profile, virtual points balance, favourite sports/teams, and preferences.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID matching document ID." },
        "displayName": { "type": "string", "description": "User display name." },
        "avatarKey": { "type": "string", "description": "Selected avatar style key." },
        "phoneNumber": { "type": "string", "description": "Optional verified mobile number." },
        "countryCode": { "type": "string", "description": "Dialing country code e.g. +91." },
        "virtualPoints": { "type": "integer", "description": "Virtual points balance (non-monetary)." },
        "totalPredictions": { "type": "integer", "description": "Total predictions submitted." },
        "correctPredictions": { "type": "integer", "description": "Correctly settled predictions." },
        "streakDays": { "type": "integer", "description": "Consecutive daily check-in count." },
        "favoriteSports": { "type": "array", "description": "Followed sports categories." },
        "favoriteTeams": { "type": "array", "description": "Followed sports teams." },
        "badges": { "type": "array", "description": "Earned achievement badge IDs." },
        "language": { "type": "string", "description": "Selected UI language." },
        "darkMode": { "type": "boolean", "description": "Whether dark mode is enabled." },
        "notificationsEnabled": { "type": "boolean", "description": "Match & reward alert preference." },
        "privacyPublicLeaderboard": { "type": "boolean", "description": "Whether user appears on public leaderboard." },
        "termsAccepted": { "type": "boolean", "description": "Terms and virtual-points disclaimer acceptance." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp on create." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp on update." }
      },
      "required": [
        "userId",
        "displayName",
        "avatarKey",
        "virtualPoints",
        "totalPredictions",
        "correctPredictions",
        "streakDays",
        "favoriteSports",
        "favoriteTeams",
        "badges",
        "language",
        "darkMode",
        "notificationsEnabled",
        "privacyPublicLeaderboard",
        "termsAccepted",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrediction": {
      "title": "UserPrediction",
      "description": "A virtual-points prediction submitted by a user on a sports match.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "matchId": { "type": "string" },
        "matchTitle": { "type": "string" },
        "sport": { "type": "string" },
        "tournament": { "type": "string" },
        "marketType": { "type": "string" },
        "selectedPick": { "type": "string" },
        "stakePoints": { "type": "integer" },
        "multiplierX100": { "type": "integer" },
        "potentialRewardPoints": { "type": "integer" },
        "status": { "type": "string", "enum": ["ACTIVE", "WON", "LOST"] },
        "resultSummary": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "matchId",
        "matchTitle",
        "sport",
        "tournament",
        "marketType",
        "selectedPick",
        "stakePoints",
        "multiplierX100",
        "potentialRewardPoints",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "RewardClaim": {
      "title": "RewardClaim",
      "description": "Record of virtual points claimed from daily login, challenges, or sports quizzes.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "rewardType": { "type": "string", "enum": ["DAILY_LOGIN", "WEEKLY_CHALLENGE", "SPORTS_QUIZ", "BADGE_BONUS"] },
        "rewardKey": { "type": "string" },
        "title": { "type": "string" },
        "pointsAwarded": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "rewardType", "rewardKey", "title", "pointsAwarded", "createdAt"]
    },
    "UserNotification": {
      "title": "UserNotification",
      "description": "Match, challenge, and achievement alerts for a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "category": { "type": "string", "enum": ["MATCH_LIVE", "TEAM_ALERT", "RESULT", "CHALLENGE", "ACHIEVEMENT"] },
        "matchId": { "type": "string" },
        "unread": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "body", "category", "unread", "createdAt", "updatedAt"]
    },
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "PII-free public leaderboard projection for a BetZone X user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "displayName": { "type": "string" },
        "avatarKey": { "type": "string" },
        "virtualPoints": { "type": "integer" },
        "totalPredictions": { "type": "integer" },
        "correctPredictions": { "type": "integer" },
        "accuracyPct": { "type": "integer" },
        "badges": { "type": "array" },
        "periodBucket": { "type": "string", "enum": ["ALL", "DAILY", "WEEKLY", "MONTHLY"] },
        "publicVisible": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "displayName",
        "avatarKey",
        "virtualPoints",
        "totalPredictions",
        "correctPredictions",
        "accuracyPct",
        "badges",
        "periodBucket",
        "publicVisible",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile, virtual points wallet, and settings."
    },
    "/users/{userId}/predictions/{predictionId}": {
      "schema": { "$ref": "#/entities/UserPrediction" },
      "description": "User virtual-points prediction entries and settlement history."
    },
    "/users/{userId}/rewards_claims/{claimId}": {
      "schema": { "$ref": "#/entities/RewardClaim" },
      "description": "User daily reward, weekly challenge, and quiz claims."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/UserNotification" },
      "description": "User notifications for live matches, teams, and achievements."
    },
    "/leaderboard_entries/{userId}": {
      "schema": { "$ref": "#/entities/LeaderboardEntry" },
      "description": "PII-free public leaderboard standings."
    }
  }
}
